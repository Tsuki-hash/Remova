# Build output & caches
node_modules
dist
src-tauri/target
src-tauri/gen
*.tsbuildinfo
*.pdb
probe_env_tmp*
coverage/

# Local-only working material — the published repo carries app source, scripts and README only.
# docs/ holds architecture, user guide, plans and release notes; Release text comes from CHANGELOG.md.
docs/
.release-notes/
.release-signing/
*.key
*.key.pub
# One-off migration / inspection helpers used during development.
scripts/archive/
# Regenerated by `tauri icon` + scripts/gen_icons.py; Remova ships no Android/iOS target.
src-tauri/icons/android/
src-tauri/icons/ios/

# Editor & OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.log

# Credentials must never be committed
.env
.env.*

# Local demo pages (never track)
flow-compare.html

# Public tree: core app + unit tests (REV-QA-01). Issue templates stay local.
#
# src-tauri/src/path_value_smoke.rs and pipeline_smoke.rs used to be ignored here too,
# but lib.rs declares both under `#[cfg(test)] mod`. A fresh clone therefore could not
# compile the test tree at all: cargo fmt --check, clippy --all-targets and
# cargo test --workspace each died on the missing module before running a single test.
# CI was disabled at the time, so nothing surfaced it. Keep the public tree
# self-consistent — if a source file is in the module tree, it is in the repo.
.github/ISSUE_TEMPLATE/

# ZCode tool-local ignore rules (not part of the app).
.zcodeignore
